# Dev backend image for docker-compose.dev.yml (ADR-0006: the single dev
# stack standardizes on public Alpine images — no registry auth needed).
#
# Extends public golang:alpine with the tools AIR needs for incremental
# rebuilds: git (module fetches) and build-base (cgo). AIR itself is
# pre-installed so the container can start as a non-root user (uid 1000)
# without needing apk at runtime (apk add requires root).
#
# A fork with a Chainguard subscription can override the base image:
#   docker compose -f docker-compose.dev.yml build \
#     --build-arg GO_BASE=dhi.io/golang:1 orkestra-backend
# (a non-Alpine base may need the apk line below adapted).
ARG GO_BASE=golang:1.26.8-alpine
FROM ${GO_BASE}

# AIR is pinned, not @latest: a release that raises its `go` directive above
# the base (matching go.mod / .mise.toml / CI) fails to build under
# GOTOOLCHAIN=local — v1.67.2 did exactly that on Go 1.25, and `@latest` would
# have broken every dev-image build the day it was tagged. Bump this together
# with GO_BASE.
ARG AIR_VERSION=v1.67.4

RUN apk add --no-cache git build-base \
 && GOBIN=/usr/local/bin go install github.com/air-verse/air@${AIR_VERSION} \
 && rm -rf /root/.cache /go/pkg

WORKDIR /app
