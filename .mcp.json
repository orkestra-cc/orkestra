{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": ["mcp-server", "--force-roots-fallback"]
    },
    "integrated-browser-mcp": {
      "command": "sh",
      "args": [
        "-lc",
        "exec mise exec -- node \"$HOME/.integrated-browser-mcp/mcp-server.mjs\""
      ]
    }
  }
}
